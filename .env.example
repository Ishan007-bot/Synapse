# ── LLM provider ─────────────────────────────────────────────
# Which provider to use by default: "groq" or "gemini"
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys) — free tier
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (https://aistudio.google.com/apikey) — free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Neo4j ────────────────────────────────────────────────────
# Local default — overridden inside docker-compose and in production
# (set NEO4J_URI to your Aura URI, e.g. neo4j+s://<id>.databases.neo4j.io).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag123

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated origins the API will accept (used by the FastAPI CORS
# middleware). In production set this to your deployed frontend's URL.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
