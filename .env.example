# ── LLM provider ─────────────────────────────────────────────
# Which provider to use by default: "groq" or "gemini"
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys) — free tier
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (https://aistudio.google.com/apikey) — free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Neo4j ────────────────────────────────────────────────────
# Matches the credentials in docker-compose.yml
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag123
